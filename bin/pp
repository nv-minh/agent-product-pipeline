#!/usr/bin/env node
import { existsSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { initCmd } from '../lib/commands/init.js'
import { statusCmd } from '../lib/commands/status.js'
import { gateCmd } from '../lib/commands/gate.js'
import { advanceCmd } from '../lib/commands/advance.js'
import { guardWriteCmd, guardStopCmd } from '../lib/commands/guard.js'
import { reviewPromptCmd, reviewRecordCmd } from '../lib/commands/review.js'
import { parseArgs } from '../lib/args.js'

const COMMANDS = {
  init: initCmd,
  status: statusCmd,
  gate: gateCmd,
  advance: advanceCmd,
  'guard-write': guardWriteCmd,
  'guard-stop': guardStopCmd,
  'review-prompt': reviewPromptCmd,
  'review-record': reviewRecordCmd,
} // các task sau đăng ký thêm vào đây

const USAGE = `Usage: pp <command> [options]

Commands:
  init <feature> [--size S|M]         Tạo blackboard cho feature mới
  status <feature>                    In stage kế tiếp và lý do
  gate <feature> <stage> [--tier t1]  Chạy gate cho một stage: exit 0 xanh, 1 đỏ
  advance <feature>                   In chỉ thị cho stage kế tiếp (pp không tự gọi LLM)
  guard-write --path <abs>            [hook] chặn agent ghi STATE.md/.evidence/ (dùng bởi PreToolUse)
  guard-stop <feature>                [hook] chặn kết thúc phiên khi còn stage chưa xanh (dùng bởi Stop)
  review-prompt <feature> <stage>     In prompt review đối kháng (artifact + rubric + constitution)
  review-record <feature> <stage> --verdict <file.json>
                                       Đọc verdict JSON, ghi evidence T2, cập nhật state

Options:
  --root DIR   Gốc repo pinnacle-product (mặc định: tự dò lên từ cwd)
  --help    In trợ giúp này
`

// Dò lên từ cwd tìm constitution.md để xác định gốc repo. KHÔNG throw khi
// không tìm thấy — trả về null. Lý do: findRoot chạy cho MỌI lệnh (kể cả
// những lệnh sau này như `pp guard-write` được một PreToolUse hook gọi trên
// từng file Write/Edit ở BẤT KỲ project nào trên máy người dùng). Nếu throw
// ở đây, chạy `pp guard-write` ngoài repo này sẽ làm cả hook đó chặn mọi
// chỉnh sửa file trong mọi project khác — hỏng toàn bộ toolchain của họ.
// Vì vậy: "không có root" không phải là lỗi ở tầng này; từng lệnh cần root
// tự kiểm tra `root` và báo lỗi rõ ràng nếu cần.
function findRoot(args) {
  const { flags } = parseArgs(args)
  // --root không có giá trị (token cuối, hoặc theo sau là flag khác) thì
  // parseArgs trả flags.root = true — bỏ qua, để rơi xuống dò theo cwd
  // thay vì resolve(true) (từng ném TypeError trước khi có parseArgs).
  if (typeof flags.root === 'string') return resolve(flags.root)
  let dir = process.cwd()
  while (dir !== '/') {
    if (existsSync(join(dir, 'constitution.md'))) return dir
    dir = resolve(dir, '..')
  }
  return null
}

async function main(argv) {
  const [cmd, ...rest] = argv
  if (!cmd || cmd === '--help' || cmd === '-h') {
    process.stdout.write(USAGE)
    return cmd ? 0 : 2
  }
  const handler = COMMANDS[cmd]
  if (!handler) {
    process.stdout.write(`pp: không biết lệnh "${cmd}"\n\n${USAGE}`)
    return 2
  }
  return await handler(rest, { root: findRoot(rest) })
}

main(process.argv.slice(2))
  .then((code) => process.exit(code ?? 0))
  .catch((err) => { process.stderr.write(`pp: ${err.message}\n`); process.exit(1) })
