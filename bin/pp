#!/usr/bin/env node
import { existsSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { initCmd } from '../lib/commands/init.js'
import { statusCmd } from '../lib/commands/status.js'
import { gateCmd } from '../lib/commands/gate.js'
import { advanceCmd } from '../lib/commands/advance.js'
import { guardWriteCmd, guardStopCmd } from '../lib/commands/guard.js'
import { reviewPromptCmd, reviewRecordCmd } from '../lib/commands/review.js'
import { approveCmd, overrideCmd, unblockCmd } from '../lib/commands/human.js'
import { reportCmd } from '../lib/commands/report.js'
import { usageSyncCmd } from '../lib/commands/usage.js'
import { doctorCmd } from '../lib/commands/doctor.js'
import { badFeatureName } from '../lib/commands/precond.js'
import { parseArgs } from '../lib/args.js'

const COMMANDS = {
  init: initCmd,
  status: statusCmd,
  gate: gateCmd,
  advance: advanceCmd,
  'guard-write': guardWriteCmd,
  'guard-stop': guardStopCmd,
  'review-prompt': reviewPromptCmd,
  'review-record': reviewRecordCmd,
  approve: approveCmd,
  override: overrideCmd,
  unblock: unblockCmd,
  report: reportCmd,
  'usage-sync': usageSyncCmd,
  doctor: doctorCmd,
}

// Mọi lệnh nhận <feature> làm positional đầu tiên (kể cả tuỳ chọn như report,
// guard-stop) — dùng cho kiểm tên tập trung ở main(). guard-write không nhận
// positional (chỉ --path/--stdin) nên không nằm đây.
const TAKES_FEATURE = new Set([
  'init', 'status', 'gate', 'advance', 'review-prompt', 'review-record',
  'approve', 'override', 'unblock', 'report', 'usage-sync', 'guard-stop',
])

const USAGE = `Usage: pp <command> [options]

Commands:
  init <feature> [--size S|M] [--type feature|bugfix|change] [--from <feature-cũ>]
                                       Tạo blackboard mới; --type chọn pipeline theo loại việc,
                                       --from <feature-cũ> (tuỳ chọn, chỉ có nghĩa với --type change)
                                       liên kết feature gốc cho impact analysis; không truyền thì
                                       change chạy không truy nguồn gốc
  status <feature>                    In stage kế tiếp và lý do
  gate <feature> <stage> [--tier t1] [--dry-run]
                                       Chạy gate T1 cho một stage: exit 0 xanh, 1 đỏ. --tier chỉ
                                       nhận t1 (T2 chạy bằng review-prompt/review-record); giá trị
                                       khác bị từ chối exit 2 thay vì âm thầm chạy T1. --dry-run
                                       chạy đúng tập check nhưng KHÔNG ghi sổ: attempts/evidence/
                                       STATE/audit không đổi — xem artifact có qua không đã
  advance <feature>                   In chỉ thị cho stage kế tiếp (pp không tự gọi LLM)
  guard-write --path <abs> | --stdin  [hook] chặn agent ghi STATE.md/.evidence//pipeline.json
                                       trong features/ (dùng bởi PreToolUse). Chặn = exit 2 + stderr
                                       (hợp đồng hook của Claude Code); cho phép = exit 0
  guard-stop [<feature>]              [hook] chặn kết thúc phiên khi còn stage failed/in_progress
                                       (dùng bởi Stop). Không truyền feature thì soát MỌI feature;
                                       không tìm thấy gốc repo thì exit 0. Chặn = exit 2 + stderr
  review-prompt <feature> <stage>     In prompt review đối kháng (artifact + rubric + constitution)
  review-record <feature> <stage> --verdict <file.json>
                                       Đọc verdict JSON, ghi evidence T2, cập nhật state
  approve <feature> <stage>           Duyệt một stage đã gate pass (bắt buộc để advance đi tiếp)
  override <feature> <stage> --reason "<chữ>"
                                       Cửa thoát hiểm: ép một stage thành done bất kể gate. Bắt
                                       buộc lý do, luôn ghi vào lessons/<stage>.md
  unblock <feature> <stage> --reason "<chữ>"
                                       Gỡ một stage blocked: reset attempts về 0. Bắt buộc lý do,
                                       cũng ghi vào lessons/<stage>.md
  report [<feature>]                  In bảng stage/status/attempts/override cho một hoặc mọi
                                       feature; nêu bật stage bị override ≥3 lần
  doctor                              Kiểm tầng thi hành: script hook, luật guard, và hook đã
                                       được đăng ký ở settings.json nào chưa. exit 1 nếu có lỗi
  usage-sync <feature> [--since <iso>] [--transcripts DIR] [--repos DIR,DIR]
                                       Khai thác transcript Claude Code (~/.claude/projects)
                                       lấy token usage thật, gán về feature/theo stage; idempotent.
                                       --repos khai thêm các repo code (backend/web) — phiên viết
                                       code sống ở dir transcript của repo ĐÓ, không phải của
                                       product-repo. Thiếu transcript = thiếu dữ liệu (exit 0)

Options:
  --root DIR       Gốc product-repo (mặc định: tự dò lên từ cwd)
  --workspace DIR  Gốc để giải nghĩa đường dẫn được CITE trong artifact
                   (mặc định: thư mục cha của --root, tức layout product-repo
                   nằm cạnh các repo code). Cũng đọc từ $PP_WORKSPACE
  --help           In trợ giúp này
`

// C4 — "GỐC REPO LÀ GÌ" từng chỉ có một câu trả lời: thư mục có constitution.md.
// Nhưng constitution.md là quy ước CHUNG (GitHub Spec Kit dùng đúng tên này) —
// đứng trong một repo Spec Kit bất kỳ mà gõ `pp init` là scaffold nguyên bộ
// features/ vào repo của người ta. `.pp-root` là marker RIÊNG của pp (check-in
// tại gốc product-repo); constitution.md giữ vai trò fallback để clone cũ và
// các lệnh chỉ-đọc vẫn chạy. Riêng `pp init` (lệnh scaffold duy nhất) đòi đích
// danh `.pp-root` — xem initCmd.
function isPpRoot(dir) {
  return existsSync(join(dir, '.pp-root')) || existsSync(join(dir, 'constitution.md'))
}

// Dò lên từ cwd tìm marker gốc repo. KHÔNG throw khi không tìm thấy — trả về
// null. Lý do: findRoot chạy cho MỌI lệnh (kể cả những lệnh sau này như
// `pp guard-write` được một PreToolUse hook gọi trên từng file Write/Edit ở
// BẤT KỲ project nào trên máy người dùng). Nếu throw ở đây, chạy
// `pp guard-write` ngoài repo này sẽ làm cả hook đó chặn mọi chỉnh sửa file
// trong mọi project khác — hỏng toàn bộ toolchain của họ. Vì vậy: "không có
// root" không phải là lỗi ở tầng này; từng lệnh cần root tự kiểm tra `root`
// và báo lỗi rõ ràng nếu cần.
function findRoot(args) {
  const { flags } = parseArgs(args)
  // --root không có giá trị (token cuối, hoặc theo sau là flag khác) thì
  // parseArgs trả flags.root = true — bỏ qua, để rơi xuống dò theo cwd
  // thay vì resolve(true) (từng ném TypeError trước khi có parseArgs).
  if (typeof flags.root === 'string') return resolve(flags.root)
  let dir = process.cwd()
  while (dir !== '/') {
    if (isPpRoot(dir)) return dir
    dir = resolve(dir, '..')
  }
  return null
}

// FINDING (review 8c825c9..44c1ecb): một flag GÕ SAI TÊN đi qua cả CLI mà
// không ai từ chối — `pp init x --type change --form old-a` exit 0 rồi lặng lẽ
// bỏ đúng cái liên kết vừa được yêu cầu. Allowlist chung cho cả CLI: rẻ, và đủ
// bắt lớp lỗi đánh máy.
//
// FINDING (lab 2026-08-21) — lớp HAI: flag ĐÚNG TÊN nhưng dùng SAI LỆNH.
// `pp review-record f s --from x` từng chỉ in lại usage mà không nói flag nào
// đang thừa; người dùng phải tự diff usage với dòng lệnh của mình. Mỗi lệnh
// khai flag của riêng nó; flag đúng-tên-sai-lệnh bị nêu đích danh kèm flag đúng.
const SHARED_FLAGS = ['root', 'workspace']
const FLAGS_OF_COMMAND = {
  init: ['size', 'type', 'from'],
  status: [],
  gate: ['tier', 'dry-run'],
  advance: [],
  'guard-write': ['path', 'stdin'],
  'guard-stop': [],
  'review-prompt': [],
  'review-record': ['verdict'],
  approve: [],
  override: ['reason'],
  unblock: ['reason'],
  report: [],
  'usage-sync': ['since', 'transcripts', 'repos'],
  doctor: [],
}
const KNOWN_FLAGS = new Set([...SHARED_FLAGS, ...Object.values(FLAGS_OF_COMMAND).flat()])

function badFlag(args, cmd) {
  const flags = Object.keys(parseArgs(args).flags)
  const unknown = flags.filter((f) => !KNOWN_FLAGS.has(f))
  if (unknown.length) {
    process.stderr.write(
      `pp: không biết flag ${unknown.map((f) => `--${f}`).join(', ')}.\n` +
      `Flag hợp lệ: ${[...KNOWN_FLAGS].sort().map((f) => `--${f}`).join(' ')}\n` +
      'Gõ sai tên flag KHÔNG được ngầm coi là "không truyền flag" — nó làm mất ' +
      'chính điều bạn vừa yêu cầu mà không ai biết.\n',
    )
    return true
  }
  // cmd lạ (đường gọi không qua main) chỉ qua lớp 1 — không chết oan.
  if (!FLAGS_OF_COMMAND[cmd]) return false
  const hợpLệnh = new Set([...FLAGS_OF_COMMAND[cmd], ...SHARED_FLAGS])
  const saiLệnh = flags.filter((f) => !hợpLệnh.has(f))
  if (saiLệnh.length) {
    const củaLệnh = FLAGS_OF_COMMAND[cmd]
    process.stderr.write(
      `pp: ${saiLệnh.map((f) => `--${f}`).join(', ')} không dùng được với lệnh "${cmd}" — ` +
      `lệnh này nhận: ${củaLệnh.length ? củaLệnh.map((f) => `--${f}`).join(' ') : 'chỉ --root/--workspace'}\n`,
    )
    return true
  }
  return false
}

// C3 — `--root` TỪNG ĐƯỢC TIN KHÔNG KIỂM, KHÁC HẲN NHÁNH DÒ CWD NGAY TRÊN.
// Tái lập được: `pp init foo --root /một/thư/mục/rỗng` scaffold nguyên cây
// features/ vào đó, exit 0 — một lần gõ nhầm đường dẫn là rác mọc ở chỗ
// không ai ngờ. Đối số tường minh mà sai thì phải chết to (exit 2), không
// được âm thầm làm theo.
function badExplicitRoot(args) {
  const { flags } = parseArgs(args)
  if (typeof flags.root !== 'string') return false
  const r = resolve(flags.root)
  if (isPpRoot(r)) return false
  process.stdout.write(
    `pp: --root ${flags.root} không phải gốc product-repo — không thấy .pp-root hay constitution.md ở ${r}.\n` +
    'Kiểm tra lại đường dẫn. Nếu đây đúng là product-repo mới, tạo marker: touch <root>/.pp-root\n',
  )
  return true
}

// Gốc để giải nghĩa đường dẫn được CITE trong artifact (trụ cột 3, §6). Mặc
// định là thư mục cha của root — đúng layout A (product-repo nằm cạnh
// backend-repo/web-repo) và giữ nguyên hành vi cũ. Cho phép ghi đè vì layout đó
// không phải phổ quát: clone product-repo vào một chỗ khác thì mọi cite bị kiểm
// ngược vào thư mục cha ngẫu nhiên đó, biến gate chống ảo giác thành đỏ oan.
// Cùng quy tắc "flag không có giá trị thì bỏ qua" như --root.
function findWorkspace(args, root) {
  const { flags } = parseArgs(args)
  if (typeof flags.workspace === 'string') return resolve(flags.workspace)
  if (process.env.PP_WORKSPACE) return resolve(process.env.PP_WORKSPACE)
  return root ? resolve(root, '..') : null
}

async function main(argv) {
  const [cmd, ...rest] = argv
  if (cmd === '--help' || cmd === '-h' || cmd === 'help') {
    process.stdout.write(USAGE)
    return 0
  }
  if (!cmd) {
    // Gõ `pp` trống là lỗi dùng (exit 2); trợ giúp in ra stderr để scripting
    // (`pp 2>/dev/null`) không nhặt nhầm usage làm dữ liệu.
    process.stderr.write(USAGE)
    return 2
  }
  const handler = COMMANDS[cmd]
  if (!handler) {
    process.stderr.write(`pp: không biết lệnh "${cmd}"\n\n${USAGE}`)
    return 2
  }
  // C2: kiểm tên feature Ở ĐÂY, một chỗ cho mọi lệnh — một tên mang "/" hay
  // ".." không được chạm tới bất kỳ join() nào trong handler. Lệnh có feature
  // TUỲ CHỌN (report, guard-stop) chỉ kiểm khi có; thiếu hẳn thì handler tự in
  // usage của nó (thiếu đối số là chuyện khác với đối số độc hại).
  if (TAKES_FEATURE.has(cmd)) {
    const feature = parseArgs(rest).positional[0]
    if (feature !== undefined && badFeatureName(feature)) return 2
  }
  // Flag lạ chết TRƯỚC mọi thứ khác: nếu người dùng gõ sai tên flag thì mọi
  // suy luận sau đó (kể cả --root) đang dựa trên một dòng lệnh khác dòng họ nghĩ.
  if (badFlag(rest, cmd)) return 2
  if (badExplicitRoot(rest)) return 2
  const root = findRoot(rest)
  return await handler(rest, { root, workspace: findWorkspace(rest, root) })
}

main(process.argv.slice(2))
  .then((code) => process.exit(code ?? 0))
  .catch((err) => { process.stderr.write(`pp: ${err.message}\n`); process.exit(err.exitCode ?? 1) })
