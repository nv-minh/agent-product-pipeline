{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(features/*/STATE.md)",
      "Edit(features/*/pipeline.json)",
      "Edit(features/*/audit.jsonl)",
      "Edit(features/*/.evidence/**)",
      "Edit(features/*/.review/**)",
      "Edit(features/*/.usage/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-tool-use.sh\"",
            "timeout": 10,
            "statusMessage": "pp guard-write"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/stop.sh\"",
            "timeout": 10,
            "statusMessage": "pp guard-stop"
          }
        ]
      }
    ]
  }
}
